<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
                             http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

  <context-param>
    <param-name>dbUrl</param-name>
    <param-value>jdbc:mysql://127.0.0.1:3306/StudentCompany?serverTimezone=UTC</param-value>
  </context-param>

  <context-param>
    <param-name>dbUser</param-name>
    <param-value>root</param-value>
  </context-param>

  <context-param>
    <param-name>dbPassword</param-name>
    <param-value>password_2024</param-value>

  </context-param>

  <context-param>
    <param-name>dbDriver</param-name>
    <param-value>com.mysql.cj.jdbc.Driver</param-value>
  </context-param>

  <filter>
    <filter-name>LoginCheck</filter-name>
    <filter-class>polimi.SE2.SC.filters.LoginCheck</filter-class>
  </filter>

  <filter>
    <filter-name>NoCacher</filter-name>
    <filter-class>polimi.SE2.SC.filters.NoCacher</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>LoginCheck</filter-name>
    <url-pattern>/homePage.html</url-pattern>
    <url-pattern>/ApplyToInternship</url-pattern>
    <url-pattern>/CloseComplaint</url-pattern>
    <url-pattern>/CompleteQuestionnaire</url-pattern>
    <url-pattern>/EndInternship</url-pattern>
    <url-pattern>/EvaluateInterview</url-pattern>
    <url-pattern>/EvaluateQuestionnaire</url-pattern>
    <url-pattern>/HomePageManager</url-pattern>
    <url-pattern>/ManageStudentApplication</url-pattern>
    <url-pattern>/MessagesManager</url-pattern>
    <url-pattern>/ModifyCv</url-pattern>
    <url-pattern>/ModifyInternship</url-pattern>
    <url-pattern>/ModifyInternship</url-pattern>
    <url-pattern>/OpenChatWindow</url-pattern>
    <url-pattern>/OpenMyInternshipInformationSpace</url-pattern>
    <url-pattern>/ReadComplaint</url-pattern>
    <url-pattern>/ReadFeedback</url-pattern>
    <url-pattern>/ReadMessage</url-pattern>
    <url-pattern>/RejectComplaintClosure</url-pattern>
    <url-pattern>/RejectInterviewDate</url-pattern>
    <url-pattern>/ScheduleInterview</url-pattern>
    <url-pattern>/SearchPageManager</url-pattern>
    <url-pattern>/SendMessage</url-pattern>
    <url-pattern>/StartInternship</url-pattern>
    <url-pattern>/UploadComplaint</url-pattern>
    <url-pattern>/UploadFeedback</url-pattern>
    <url-pattern>/UploadNewCv</url-pattern>
    <url-pattern>/UploadNewInternship</url-pattern>
    <url-pattern>/UploadQuestionnaire</url-pattern>
  </filter-mapping>

  <filter-mapping>
    <filter-name>NoCacher</filter-name>
    <url-pattern>/mainPage.html</url-pattern>
    <url-pattern>/homePage.html</url-pattern>
  </filter-mapping>

  <welcome-file-list>
    <welcome-file>mainPage.html</welcome-file>
  </welcome-file-list>
</web-app>
